@model Staff
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <h2 class="text-center mb-4">Eliminar empleado</h2>
        <div class="alert alert-warning">¿Estás seguro que deseas eliminar a este empleado? Esta acción no se puede deshacer.</div>
        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <h5 class="card-title border-bottom pb-2 mb-3">@Model.Nombre</h5>
                <p class="card-text">
                    <strong>Cédula:</strong> @Model.Cedula<br />
                    <strong>Cargo:</strong> @Model.Cargo<br />
                    <strong>Departamento:</strong> @Model.Departamento<br />
                    <strong>Salario:</strong> @Model.Salario.ToString("C")
                </p>
                <form asp-action="Delete" method="post" class="mt-4">
                    <input asp-for="Id" type="hidden" />
                    <button type="submit" class="btn btn-danger">Confirmar eliminación</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>