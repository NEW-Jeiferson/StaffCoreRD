@model Staff
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <h2 class="text-center mb-4">Perfil del empleado</h2>
        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <h5 class="card-title border-bottom pb-2 mb-3">@Model.Nombre</h5>
                <p class="card-text">
                    <strong>Cédula:</strong> @Model.Cedula<br />
                    <strong>Cargo:</strong> @Model.Cargo<br />
                    <strong>Departamento:</strong> @Model.Departamento<br />
                    <strong>Salario:</strong> @Model.Salario.ToString("C")<br />
                    <strong>Fecha de ingreso:</strong> @Model.FechaIngreso.ToShortDateString()<br />
                    <strong>Estado:</strong>
                    @if (Model.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </p>
                <div class="mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Volver</a>
                </div>
            </div>
        </div>
    </div>
</div>