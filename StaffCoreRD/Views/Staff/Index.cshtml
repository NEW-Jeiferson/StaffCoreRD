@model List<Staff>
<h2>Personal Activo</h2>

<div class="d-flex gap-2 mb-3">
    @if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
    {
        <a asp-action="Create" class="btn btn-success">+ Nuevo</a>
    }
    <a asp-action="Resumen" class="btn btn-outline-primary">Ver resumen por departamento</a>
</div>

<form method="get" class="mb-3">
    <input type="text" name="busqueda" class="form-control" placeholder="Buscar por nombre..."
           value="@ViewBag.Busqueda" onchange="this.form.submit()" />
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay empleados registrados actualmente.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Cargo</th>
                <th>Departamento</th>
                <th>Salario</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Nombre</td>
                    <td>@s.Cargo</td>
                    <td>@s.Departamento</td>
                    <td>@s.Salario.ToString("C")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-info btn-sm">Detalles</a>
                        @if (User.IsInRole("Administrador") || User.IsInRole("RRHH"))
                        {
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-warning btn-sm">Editar</a>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-danger btn-sm">Eliminar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">Total de nómina</th>
                <th colspan="2">@Model.Sum(s => s.Salario).ToString("C")</th>
            </tr>
        </tfoot>
    </table>
}